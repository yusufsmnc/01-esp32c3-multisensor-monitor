# Normalize line endings to LF in the repository and working tree,
# regardless of the developer's core.autocrlf setting (Windows host,
# Linux CI). Keeps diffs clean and shell/Python tools working.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never touch.
*.png binary
*.jpg binary
*.pdf binary
*.bin binary
*.elf binary
